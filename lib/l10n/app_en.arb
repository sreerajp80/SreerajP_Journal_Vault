  },
  "descRitualCard05Prompt": "When life tests you, what principle or value do you refuse to compromise? Why does it matter to you?",
  "@descRitualCard05Prompt": {
    "description": "Ritual deck card 5: reflection prompt."
  },
  "descRitualCard05Quote": "Even in the most difficult of times, one should not abandon Dharma.",
  "@descRitualCard05Quote": {
    "description": "Ritual deck card 5: quote."
  },
  "descRitualCard05Source": "Ramayana, Ayodhya Kanda",
  "@descRitualCard05Source": {
    "description": "Ritual deck card 5: source of the quote."
  },
  "descRitualCard06Title": "Action Without Attachment",
  "@descRitualCard06Title": {
    "description": "Ritual deck card 6: title."
  },
  "descRitualCard06Prompt": "What is one task or effort you are doing today where you can let go of the result and focus purely on the quality of your action?",
  "@descRitualCard06Prompt": {
    "description": "Ritual deck card 6: reflection prompt."
  },
  "descRitualCard06Quote": "You have the right to perform your duty, but you are not entitled to the fruits of your actions.",
  "@descRitualCard06Quote": {
    "description": "Ritual deck card 6: quote."
  },
  "descRitualCard06Source": "Bhagavad Gita 2.47",
  "@descRitualCard06Source": {
    "description": "Ritual deck card 6: source of the quote."
  },
  "descRitualCard07Title": "The Seed You Plant Today",
  "@descRitualCard07Title": {
    "description": "Ritual deck card 7: title."
  },
  "descRitualCard07Prompt": "Every action is a seed. What kind of seed — patience, kindness, discipline, or something else — are you planting today?",
  "@descRitualCard07Prompt": {
    "description": "Ritual deck card 7: reflection prompt."
  },
  "descRitualCard07Quote": "As a man sows, so shall he reap. There is no escape from the fruits of one's actions.",
  "@descRitualCard07Quote": {
    "description": "Ritual deck card 7: quote."
  },
  "descRitualCard07Source": "Mahabharata, Vana Parva",
  "@descRitualCard07Source": {
    "description": "Ritual deck card 7: source of the quote."
  },
  "descRitualCard08Title": "Nishkama Karma",
  "@descRitualCard08Title": {
    "description": "Ritual deck card 8: title."
  },
  "descRitualCard08Prompt": "Think of something you did purely for its own sake, without wanting praise or reward. How did that feel? Can you bring that spirit to more of your day?",
  "@descRitualCard08Prompt": {
    "description": "Ritual deck card 8: reflection prompt."
  },
  "descRitualCard08Quote": "The wise, engaged in selfless action, surrender all attachment to results and attain supreme peace.",
  "@descRitualCard08Quote": {
    "description": "Ritual deck card 8: quote."
  },
  "descRitualCard08Source": "Bhagavad Gita 5.12",
  "@descRitualCard08Source": {
    "description": "Ritual deck card 8: source of the quote."
  },
  "descRitualCard09Title": "Breaking the Chain",
  "@descRitualCard09Title": {
    "description": "Ritual deck card 9: title."
  },
  "descRitualCard09Prompt": "Is there a pattern of reaction — anger, avoidance, blame — that you keep repeating? What would it look like to consciously choose a different response today?",
  "@descRitualCard09Prompt": {
    "description": "Ritual deck card 9: reflection prompt."
  },
  "descRitualCard09Quote": "One who restrains the senses and organs of action, but whose mind dwells on sense objects, is deluded and called a hypocrite.",
  "@descRitualCard09Quote": {
    "description": "Ritual deck card 9: quote."
  },
  "descRitualCard09Source": "Bhagavad Gita 3.6",
  "@descRitualCard09Source": {
    "description": "Ritual deck card 9: source of the quote."
  },
  "descRitualCard10Title": "Karma Yoga in Daily Life",
  "@descRitualCard10Title": {
    "description": "Ritual deck card 10: title."
  },
  "descRitualCard10Prompt": "How can you transform an ordinary task today — cooking, cleaning, working — into an offering, performing it with full attention and devotion?",
  "@descRitualCard10Prompt": {
    "description": "Ritual deck card 10: reflection prompt."
  },
  "descRitualCard10Quote": "Whatever you do, whatever you eat, whatever you offer in sacrifice, whatever you give, whatever austerity you practise — do it as an offering to Me.",
  "@descRitualCard10Quote": {
    "description": "Ritual deck card 10: quote."
  },
  "descRitualCard10Source": "Bhagavad Gita 9.27",
  "@descRitualCard10Source": {
    "description": "Ritual deck card 10: source of the quote."
  },
  "descRitualCard11Title": "The Heart of Devotion",
  "@descRitualCard11Title": {
    "description": "Ritual deck card 11: title."
  },
  "descRitualCard11Prompt": "What fills your heart with reverence and love — a prayer, a memory, a place, the thought of the Divine? Dwell on it now.",
  "@descRitualCard11Prompt": {
    "description": "Ritual deck card 11: reflection prompt."
  },
  "descRitualCard11Quote": "Whoever offers Me with devotion a leaf, a flower, a fruit, or water — that offering of love I accept from the pure-hearted.",
  "@descRitualCard11Quote": {
    "description": "Ritual deck card 11: quote."
  },
  "descRitualCard11Source": "Bhagavad Gita 9.26",
  "@descRitualCard11Source": {
    "description": "Ritual deck card 11: source of the quote."
  },
  "descRitualCard12Title": "Surrender and Trust",
  "@descRitualCard12Title": {
    "description": "Ritual deck card 12: title."
  },
  "descRitualCard12Prompt": "What worry or burden can you mentally place at the feet of the Divine today, trusting that grace will carry you through?",
  "@descRitualCard12Prompt": {
    "description": "Ritual deck card 12: reflection prompt."
  },
  "descRitualCard12Quote": "Abandon all varieties of Dharma and simply surrender unto Me. I shall deliver you from all sinful reactions; do not fear.",
  "@descRitualCard12Quote": {
    "description": "Ritual deck card 12: quote."
  },
  "descRitualCard12Source": "Bhagavad Gita 18.66",
  "@descRitualCard12Source": {
    "description": "Ritual deck card 12: source of the quote."
  },
  "descRitualCard13Title": "Seeing God in All",
  "@descRitualCard13Title": {
    "description": "Ritual deck card 13: title."
  },
  "descRitualCard13Prompt": "Can you look at every person you meet today as a form of the Divine? How would that change the way you speak and listen?",
  "@descRitualCard13Prompt": {
    "description": "Ritual deck card 13: reflection prompt."
  },
  "descRitualCard13Quote": "The wise see the same Divine Self equally in a learned Brahmin, a cow, an elephant, a dog, and an outcaste.",
  "@descRitualCard13Quote": {
    "description": "Ritual deck card 13: quote."
  },
  "descRitualCard13Source": "Bhagavad Gita 5.18",
  "@descRitualCard13Source": {
    "description": "Ritual deck card 13: source of the quote."
  },
  "descRitualCard14Title": "The Name that Purifies",
  "@descRitualCard14Title": {
    "description": "Ritual deck card 14: title."
  },
  "descRitualCard14Prompt": "When was the last time you sat quietly and repeated a sacred name or mantra? What feelings arose when you did?",
  "@descRitualCard14Prompt": {
    "description": "Ritual deck card 14: reflection prompt."
  },
  "descRitualCard14Quote": "The name of the Lord is the boat that will take you across the ocean of worldly existence.",
  "@descRitualCard14Quote": {
    "description": "Ritual deck card 14: quote."
  },
  "descRitualCard14Source": "Tulsidas, Ramcharitmanas",
  "@descRitualCard14Source": {
    "description": "Ritual deck card 14: source of the quote."
  },
  "descRitualCard15Title": "Grace in Gratitude",
  "@descRitualCard15Title": {
    "description": "Ritual deck card 15: title."
  },
  "descRitualCard15Prompt": "What unexpected blessing or moment of grace have you received recently that you have not yet paused to acknowledge?",
  "@descRitualCard15Prompt": {
    "description": "Ritual deck card 15: reflection prompt."
  },
  "descRitualCard15Quote": "I am the origin of all. Everything emanates from Me. The wise who know this worship Me with loving devotion.",
  "@descRitualCard15Quote": {
    "description": "Ritual deck card 15: quote."
  },
  "descRitualCard15Source": "Bhagavad Gita 10.8",
  "@descRitualCard15Source": {
    "description": "Ritual deck card 15: source of the quote."
  },
  "descRitualCard16Title": "Who Am I?",
  "@descRitualCard16Title": {
    "description": "Ritual deck card 16: title."
  },
  "descRitualCard16Prompt": "Strip away your name, your job, your roles, your body. What remains? Sit with this question: Who am I beyond all labels?",
  "@descRitualCard16Prompt": {
    "description": "Ritual deck card 16: reflection prompt."
  },
  "descRitualCard16Quote": "Tat Tvam Asi — Thou art That.",
  "@descRitualCard16Quote": {
    "description": "Ritual deck card 16: quote."
  },
  "descRitualCard16Source": "Chandogya Upanishad 6.8.7",
  "@descRitualCard16Source": {
    "description": "Ritual deck card 16: source of the quote."
  },
  "descRitualCard17Title": "The Eternal Witness",
  "@descRitualCard17Title": {
    "description": "Ritual deck card 17: title."
  },
  "descRitualCard17Prompt": "Observe your thoughts passing by without grasping any of them. Who is the one watching? Can that awareness itself ever be harmed?",
  "@descRitualCard17Prompt": {
    "description": "Ritual deck card 17: reflection prompt."
  },
  "descRitualCard17Quote": "The Self is never born, nor does it die. It is eternal, ever-existing, and primeval. It is not slain when the body is slain.",
  "@descRitualCard17Quote": {
    "description": "Ritual deck card 17: quote."
  },
  "descRitualCard17Source": "Bhagavad Gita 2.20",
  "@descRitualCard17Source": {
    "description": "Ritual deck card 17: source of the quote."
  },
  "descRitualCard18Title": "Knowledge That Frees",
  "@descRitualCard18Title": {
    "description": "Ritual deck card 18: title."
  },
  "descRitualCard18Prompt": "What is one truth about yourself or about life that, once you truly accepted it, freed you from suffering?",
  "@descRitualCard18Prompt": {
    "description": "Ritual deck card 18: reflection prompt."
  },
  "descRitualCard18Quote": "There is nothing as purifying in this world as knowledge. One who has attained purity of mind through prolonged Yoga discovers this knowledge within, in due course of time.",
  "@descRitualCard18Quote": {
    "description": "Ritual deck card 18: quote."
  },
  "descRitualCard18Source": "Bhagavad Gita 4.38",
  "@descRitualCard18Source": {
    "description": "Ritual deck card 18: source of the quote."
  },
  "descRitualCard19Title": "Beyond the Senses",
  "@descRitualCard19Title": {
    "description": "Ritual deck card 19: title."
  },
  "descRitualCard19Prompt": "Your senses show you the surface of things. What deeper truth lies beneath the situation you are facing right now?",
  "@descRitualCard19Prompt": {
    "description": "Ritual deck card 19: reflection prompt."
  },
  "descRitualCard19Quote": "Beyond the senses are the objects; beyond the objects is the mind; beyond the mind is the intellect; beyond the intellect is the Great Self.",
  "@descRitualCard19Quote": {
    "description": "Ritual deck card 19: quote."
  },
  "descRitualCard19Source": "Katha Upanishad 1.3.10",
  "@descRitualCard19Source": {
    "description": "Ritual deck card 19: source of the quote."
  },
  "descRitualCard20Title": "The Light Within",
  "@descRitualCard20Title": {
    "description": "Ritual deck card 20: title."
  },
  "descRitualCard20Prompt": "Close your eyes. Imagine a steady flame burning in your heart that no wind can extinguish. What does this light illuminate for you?",
  "@descRitualCard20Prompt": {
    "description": "Ritual deck card 20: reflection prompt."
  },
  "descRitualCard20Quote": "Asato ma sadgamaya, tamaso ma jyotirgamaya, mrityorma amritam gamaya. Lead me from the unreal to the Real, from darkness to Light, from death to Immortality.",
  "@descRitualCard20Quote": {
    "description": "Ritual deck card 20: quote."
  },
  "descRitualCard20Source": "Brihadaranyaka Upanishad 1.3.28",
  "@descRitualCard20Source": {
    "description": "Ritual deck card 20: source of the quote."
  },
  "descRitualCard21Title": "The Fullness of Being",
  "@descRitualCard21Title": {
    "description": "Ritual deck card 21: title."
  },
  "descRitualCard21Prompt": "If you lack nothing at the deepest level, why do you feel incomplete? Reflect on what it means to be already whole.",
  "@descRitualCard21Prompt": {
    "description": "Ritual deck card 21: reflection prompt."
  },
  "descRitualCard21Quote": "Om Purnamadah Purnamidam — That is Whole, this is Whole. From the Whole, the Whole arises. When the Whole is taken from the Whole, the Whole still remains.",
  "@descRitualCard21Quote": {
    "description": "Ritual deck card 21: quote."
  },
  "descRitualCard21Source": "Isha Upanishad, Invocation",
  "@descRitualCard21Source": {
    "description": "Ritual deck card 21: source of the quote."
  },
  "descRitualCard22Title": "Brahman in Everything",
  "@descRitualCard22Title": {
    "description": "Ritual deck card 22: title."
  },
  "descRitualCard22Prompt": "The same consciousness that shines through you shines through every living being. How does this awareness change the way you see the world today?",
  "@descRitualCard22Prompt": {
    "description": "Ritual deck card 22: reflection prompt."
  },
  "descRitualCard22Quote": "Aham Brahmasmi — I am Brahman.",
  "@descRitualCard22Quote": {
    "description": "Ritual deck card 22: quote."
  },
  "descRitualCard22Source": "Brihadaranyaka Upanishad 1.4.10",
  "@descRitualCard22Source": {
    "description": "Ritual deck card 22: source of the quote."
  },
  "descRitualCard23Title": "Stilling the Mind",
  "@descRitualCard23Title": {
    "description": "Ritual deck card 23: title."
  },
  "descRitualCard23Prompt": "Right now, observe the fluctuations of your mind — planning, worrying, remembering. Can you gently bring all of them to stillness, even for a few breaths?",
  "@descRitualCard23Prompt": {
    "description": "Ritual deck card 23: reflection prompt."
  },
  "descRitualCard23Quote": "Yogas chitta vritti nirodhah — Yoga is the cessation of the fluctuations of the mind.",
  "@descRitualCard23Quote": {
    "description": "Ritual deck card 23: quote."
  },
  "descRitualCard23Source": "Yoga Sutras of Patanjali 1.2",
  "@descRitualCard23Source": {
    "description": "Ritual deck card 23: source of the quote."
  },
  "descRitualCard24Title": "Steady Practice",
  "@descRitualCard24Title": {
    "description": "Ritual deck card 24: title."
  },
  "descRitualCard24Prompt": "What is one positive habit or practice you can commit to with patience and devotion, knowing that consistency matters more than intensity?",
  "@descRitualCard24Prompt": {
    "description": "Ritual deck card 24: reflection prompt."
  },
  "descRitualCard24Quote": "Abhyasa — practice becomes firmly grounded when it is pursued for a long time, without interruption, and with sincere devotion.",
  "@descRitualCard24Quote": {
    "description": "Ritual deck card 24: quote."
  },
  "descRitualCard24Source": "Yoga Sutras of Patanjali 1.14",
  "@descRitualCard24Source": {
    "description": "Ritual deck card 24: source of the quote."
  },
  "descRitualCard25Title": "Evenness of Mind",
  "@descRitualCard25Title": {
    "description": "Ritual deck card 25: title."
  },
  "descRitualCard25Prompt": "Recall a recent moment of success and a moment of failure. Can you hold both with the same steady awareness, without elation or despair?",
  "@descRitualCard25Prompt": {
    "description": "Ritual deck card 25: reflection prompt."
  },
  "descRitualCard25Quote": "Yoga is equanimity of mind — samatvam yoga uchyate.",
  "@descRitualCard25Quote": {
    "description": "Ritual deck card 25: quote."
  },
  "descRitualCard25Source": "Bhagavad Gita 2.48",
  "@descRitualCard25Source": {
    "description": "Ritual deck card 25: source of the quote."
  },
  "descRitualCard26Title": "The Five Yamas",
  "@descRitualCard26Title": {
    "description": "Ritual deck card 26: title."
  },
  "descRitualCard26Prompt": "Non-violence, truthfulness, non-stealing, moderation, non-possessiveness — which of the five Yamas is the hardest for you right now, and why?",
  "@descRitualCard26Prompt": {
    "description": "Ritual deck card 26: reflection prompt."
  },
  "descRitualCard26Quote": "Ahimsa, Satya, Asteya, Brahmacharya, Aparigraha — these are the great universal vows.",
  "@descRitualCard26Quote": {
    "description": "Ritual deck card 26: quote."
  },
  "descRitualCard26Source": "Yoga Sutras of Patanjali 2.30",
  "@descRitualCard26Source": {
    "description": "Ritual deck card 26: source of the quote."
  },
  "descRitualCard27Title": "Ishvara Pranidhana",
  "@descRitualCard27Title": {
    "description": "Ritual deck card 27: title."
  },
  "descRitualCard27Prompt": "What does it feel like to offer your effort completely — not to achieve, but to dedicate? Try offering your next action to something greater than yourself.",
  "@descRitualCard27Prompt": {
    "description": "Ritual deck card 27: reflection prompt."
  },
  "descRitualCard27Quote": "By total surrender to Ishvara, Samadhi is attained.",
  "@descRitualCard27Quote": {
    "description": "Ritual deck card 27: quote."
  },
  "descRitualCard27Source": "Yoga Sutras of Patanjali 2.45",
  "@descRitualCard27Source": {
    "description": "Ritual deck card 27: source of the quote."
  },
  "descRitualCard28Title": "Non-Violence in Thought",
  "@descRitualCard28Title": {
    "description": "Ritual deck card 28: title."
  },
  "descRitualCard28Prompt": "Have you directed harsh, violent thoughts towards yourself or someone else today? What would it mean to replace them with understanding?",
  "@descRitualCard28Prompt": {
    "description": "Ritual deck card 28: reflection prompt."
  },
  "descRitualCard28Quote": "Ahimsa Paramo Dharma — Non-violence is the highest Dharma.",
  "@descRitualCard28Quote": {
    "description": "Ritual deck card 28: quote."
  },
  "descRitualCard28Source": "Mahabharata, Anushasana Parva 116.38",
  "@descRitualCard28Source": {
    "description": "Ritual deck card 28: source of the quote."
  },
  "descRitualCard29Title": "Compassion for All Beings",
  "@descRitualCard29Title": {
    "description": "Ritual deck card 29: title."
  },
  "descRitualCard29Prompt": "Think of a creature — an animal, an insect, a bird — you encountered recently. What would the world be like if you extended the same care to all living beings?",
  "@descRitualCard29Prompt": {
    "description": "Ritual deck card 29: reflection prompt."
  },
  "descRitualCard29Quote": "One who sees all beings in the Self and the Self in all beings, never turns away from it.",
  "@descRitualCard29Quote": {
    "description": "Ritual deck card 29: quote."
  },
  "descRitualCard29Source": "Isha Upanishad, Verse 6",
  "@descRitualCard29Source": {
    "description": "Ritual deck card 29: source of the quote."
  },
  "descRitualCard30Title": "Gentle Speech",
  "@descRitualCard30Title": {
    "description": "Ritual deck card 30: title."
  },
  "descRitualCard30Prompt": "Before you speak today, pause and ask: Is it true? Is it kind? Is it necessary? How does this filter change your conversations?",
  "@descRitualCard30Prompt": {
    "description": "Ritual deck card 30: reflection prompt."
  },
  "descRitualCard30Quote": "Words that do not cause distress, that are truthful, pleasant, and beneficial — this is called the austerity of speech.",
  "@descRitualCard30Quote": {
    "description": "Ritual deck card 30: quote."
  },
  "descRitualCard30Source": "Bhagavad Gita 17.15",
  "@descRitualCard30Source": {
    "description": "Ritual deck card 30: source of the quote."
  },
  "descRitualCard31Title": "Forgiving the Hurt",
  "@descRitualCard31Title": {
    "description": "Ritual deck card 31: title."
  },
  "descRitualCard31Prompt": "Who has caused you pain that you are still carrying? What would it take to forgive — not for them, but to free your own heart?",
  "@descRitualCard31Prompt": {
    "description": "Ritual deck card 31: reflection prompt."
  },
  "descRitualCard31Quote": "Forgiveness is the ornament of the brave.",
  "@descRitualCard31Quote": {
    "description": "Ritual deck card 31: quote."
  },
  "descRitualCard31Source": "Mahabharata, Udyoga Parva 33.48",
  "@descRitualCard31Source": {
    "description": "Ritual deck card 31: source of the quote."
  },
  "descRitualCard32Title": "Living in Truth",
  "@descRitualCard32Title": {
    "description": "Ritual deck card 32: title."
  },
  "descRitualCard32Prompt": "Is there something in your life where you are being less than truthful — with yourself or with others? What would honest alignment look like?",
  "@descRitualCard32Prompt": {
    "description": "Ritual deck card 32: reflection prompt."
  },
  "descRitualCard32Quote": "Satyameva Jayate — Truth alone triumphs.",
  "@descRitualCard32Quote": {
    "description": "Ritual deck card 32: quote."
  },
  "descRitualCard32Source": "Mundaka Upanishad 3.1.6",
  "@descRitualCard32Source": {
    "description": "Ritual deck card 32: source of the quote."
  },
  "descRitualCard33Title": "The Courage of Honesty",
  "@descRitualCard33Title": {
    "description": "Ritual deck card 33: title."
  },
  "descRitualCard33Prompt": "What is one truth you have been avoiding because it is uncomfortable? What would it take to face it with courage today?",
  "@descRitualCard33Prompt": {
    "description": "Ritual deck card 33: reflection prompt."
  },
  "descRitualCard33Quote": "Speak the truth. Practise Dharma. Do not neglect the study of the scriptures.",
  "@descRitualCard33Quote": {
    "description": "Ritual deck card 33: quote."
  },
  "descRitualCard33Source": "Taittiriya Upanishad 1.11.1",
  "@descRitualCard33Source": {
    "description": "Ritual deck card 33: source of the quote."
  },
  "descRitualCard34Title": "Truth Beyond Words",
  "@descRitualCard34Title": {
    "description": "Ritual deck card 34: title."
  },
  "descRitualCard34Prompt": "Truth is not only in what you say, but in what you do. Are your actions today aligned with the truth you hold in your heart?",
  "@descRitualCard34Prompt": {
    "description": "Ritual deck card 34: reflection prompt."
  },
  "descRitualCard34Quote": "By truthfulness, man reaches the station of God.",
  "@descRitualCard34Quote": {
    "description": "Ritual deck card 34: quote."
  },
  "descRitualCard34Source": "Chanakya Niti 14.3",
  "@descRitualCard34Source": {
    "description": "Ritual deck card 34: source of the quote."
  },
  "descRitualCard35Title": "The Promise You Keep",
  "@descRitualCard35Title": {
    "description": "Ritual deck card 35: title."
  },
  "descRitualCard35Prompt": "What is a promise you have made — to yourself, to another, or to the Divine — that you must honour? Recommit to it now.",
  "@descRitualCard35Prompt": {
    "description": "Ritual deck card 35: reflection prompt."
  },
  "descRitualCard35Quote": "Let your word be your bond. A person who breaks a promise breaks trust, and trust once broken is hard to rebuild.",
  "@descRitualCard35Quote": {
    "description": "Ritual deck card 35: quote."
  },
  "descRitualCard35Source": "Vidura Niti, Mahabharata",
  "@descRitualCard35Source": {
    "description": "Ritual deck card 35: source of the quote."
  },
  "descRitualCard36Title": "Letting Go",
  "@descRitualCard36Title": {
    "description": "Ritual deck card 36: title."
  },
  "descRitualCard36Prompt": "What possession, expectation, or desire are you clinging to that no longer serves your growth? Imagine gently releasing it.",
  "@descRitualCard36Prompt": {
    "description": "Ritual deck card 36: reflection prompt."
  },
  "descRitualCard36Quote": "Vairagya is the mastery of consciousness in which one is free from craving for sense objects, whether experienced directly or described.",
  "@descRitualCard36Quote": {
    "description": "Ritual deck card 36: quote."
  },
  "descRitualCard36Source": "Yoga Sutras of Patanjali 1.15",
  "@descRitualCard36Source": {
    "description": "Ritual deck card 36: source of the quote."
  },
  "descRitualCard37Title": "The Unchanging Self",
  "@descRitualCard37Title": {
    "description": "Ritual deck card 37: title."
  },
  "descRitualCard37Prompt": "Everything around you changes — moods, fortunes, relationships. What part of you has remained unchanged through all of life's storms?",
  "@descRitualCard37Prompt": {
    "description": "Ritual deck card 37: reflection prompt."
  },
  "descRitualCard37Quote": "That which is not real never was and never will be. That which is real always was and can never cease to be.",
  "@descRitualCard37Quote": {
    "description": "Ritual deck card 37: quote."
  },
  "descRitualCard37Source": "Bhagavad Gita 2.16",
  "@descRitualCard37Source": {
    "description": "Ritual deck card 37: source of the quote."
  },
  "descRitualCard38Title": "Contentment",
  "@descRitualCard38Title": {
    "description": "Ritual deck card 38: title."
  },
  "descRitualCard38Prompt": "What do you already have that is truly enough? Reflect on the difference between want and need in your life right now.",
  "@descRitualCard38Prompt": {
    "description": "Ritual deck card 38: reflection prompt."
  },
  "descRitualCard38Quote": "From contentment comes unsurpassed happiness.",
  "@descRitualCard38Quote": {
    "description": "Ritual deck card 38: quote."
  },
  "descRitualCard38Source": "Yoga Sutras of Patanjali 2.42",
  "@descRitualCard38Source": {
    "description": "Ritual deck card 38: source of the quote."
  },
  "descRitualCard39Title": "Beyond Pleasure and Pain",
  "@descRitualCard39Title": {
    "description": "Ritual deck card 39: title."
  },
  "descRitualCard39Prompt": "Can you sit with discomfort without fleeing, and with pleasure without grasping? What happens when you simply observe both?",
  "@descRitualCard39Prompt": {
    "description": "Ritual deck card 39: reflection prompt."
  },
  "descRitualCard39Quote": "One who is not disturbed by happiness and distress and is steady in both is certainly eligible for liberation.",
  "@descRitualCard39Quote": {
    "description": "Ritual deck card 39: quote."
  },
  "descRitualCard39Source": "Bhagavad Gita 2.15",
  "@descRitualCard39Source": {
    "description": "Ritual deck card 39: source of the quote."
  },
  "descRitualCard40Title": "The Joy of Giving",
  "@descRitualCard40Title": {
    "description": "Ritual deck card 40: title."
  },
  "descRitualCard40Prompt": "What can you give today — time, attention, a kind word, a helping hand — without expecting anything in return?",
  "@descRitualCard40Prompt": {
    "description": "Ritual deck card 40: reflection prompt."
  },
  "descRitualCard40Quote": "The highest form of charity is helping those who are helpless.",
  "@descRitualCard40Quote": {
    "description": "Ritual deck card 40: quote."
  },
  "descRitualCard40Source": "Thirukkural 221",
  "@descRitualCard40Source": {
    "description": "Ritual deck card 40: source of the quote."
  },
  "descRitualCard41Title": "Serving the Divine in Others",
  "@descRitualCard41Title": {
    "description": "Ritual deck card 41: title."
  },
  "descRitualCard41Prompt": "If the person standing in front of you were God in disguise, how would you treat them? Try living this for the next hour.",
  "@descRitualCard41Prompt": {
    "description": "Ritual deck card 41: reflection prompt."
  },
  "descRitualCard41Quote": "Service to humanity is service to God.",
  "@descRitualCard41Quote": {
    "description": "Ritual deck card 41: quote."
  },
  "descRitualCard41Source": "Swami Vivekananda",
  "@descRitualCard41Source": {
    "description": "Ritual deck card 41: source of the quote."
  },
  "descRitualCard42Title": "Selfless Work",
  "@descRitualCard42Title": {
    "description": "Ritual deck card 42: title."
  },
  "descRitualCard42Prompt": "Recall a time when you helped someone and felt a quiet, deep joy that had nothing to do with recognition. What did that teach you?",
  "@descRitualCard42Prompt": {
    "description": "Ritual deck card 42: reflection prompt."
  },
  "descRitualCard42Quote": "Arise, awake, and stop not till the goal is reached.",
  "@descRitualCard42Quote": {
    "description": "Ritual deck card 42: quote."
  },
  "descRitualCard42Source": "Katha Upanishad 1.3.14 / Swami Vivekananda",
  "@descRitualCard42Source": {
    "description": "Ritual deck card 42: source of the quote."
  },
  "descRitualCard43Title": "Vasudhaiva Kutumbakam",
  "@descRitualCard43Title": {
    "description": "Ritual deck card 43: title."
  },
  "descRitualCard43Prompt": "The whole world is one family. What is one step you can take today to live as though every person's well-being matters to you?",
  "@descRitualCard43Prompt": {
    "description": "Ritual deck card 43: reflection prompt."
  },
  "descRitualCard43Quote": "Vasudhaiva Kutumbakam — the entire world is one family.",
  "@descRitualCard43Quote": {
    "description": "Ritual deck card 43: quote."
  },
  "descRitualCard43Source": "Maha Upanishad 6.71",
  "@descRitualCard43Source": {
    "description": "Ritual deck card 43: source of the quote."
  },
  "descRitualCard44Title": "The Wealth of Kindness",
  "@descRitualCard44Title": {
    "description": "Ritual deck card 44: title."
  },
  "descRitualCard44Prompt": "What small act of kindness did someone do for you that you still remember? How can you pass that same kindness forward today?",
  "@descRitualCard44Prompt": {
    "description": "Ritual deck card 44: reflection prompt."
  },
  "descRitualCard44Quote": "Even the poverty of the poor will depart if they give, with compassion, even what little they have.",
  "@descRitualCard44Quote": {
    "description": "Ritual deck card 44: quote."
  },
  "descRitualCard44Source": "Thirukkural 247",
  "@descRitualCard44Source": {
    "description": "Ritual deck card 44: source of the quote."
  },
  "descRitualCard45Title": "The Peace Within",
  "@descRitualCard45Title": {
    "description": "Ritual deck card 45: title."
  },
  "descRitualCard45Prompt": "Close your eyes and take three slow breaths. Feel the silence between each breath. That silence is who you truly are. Can you carry it through the day?",
  "@descRitualCard45Prompt": {
    "description": "Ritual deck card 45: reflection prompt."
  },
  "descRitualCard45Quote": "For one who has conquered the mind, the mind is the best of friends; but for one who has failed to do so, the mind will remain the greatest enemy.",
  "@descRitualCard45Quote": {
    "description": "Ritual deck card 45: quote."
  },
  "descRitualCard45Source": "Bhagavad Gita 6.6",
  "@descRitualCard45Source": {
    "description": "Ritual deck card 45: source of the quote."
  },
  "descRitualCard46Title": "Equanimity in Praise and Blame",
  "@descRitualCard46Title": {
    "description": "Ritual deck card 46: title."
  },
  "descRitualCard46Prompt": "Recall a recent praise and a recent criticism you received. Can you hold both with the same calm composure, without clinging to one or rejecting the other?",
  "@descRitualCard46Prompt": {
    "description": "Ritual deck card 46: reflection prompt."
  },
  "descRitualCard46Quote": "One who is the same to friend and foe, in honour and dishonour, in heat and cold, in pleasure and pain, and is free from attachment — such a person is dear to Me.",
  "@descRitualCard46Quote": {
    "description": "Ritual deck card 46: quote."
  },
  "descRitualCard46Source": "Bhagavad Gita 12.18–19",
  "@descRitualCard46Source": {
    "description": "Ritual deck card 46: source of the quote."
  },
  "descRitualCard47Title": "The Lotus in Mud",
  "@descRitualCard47Title": {
    "description": "Ritual deck card 47: title."
  },
  "descRitualCard47Prompt": "A lotus blooms in muddy water yet remains unstained. What is the muddy situation in your life right now, and how can you remain untouched by it while still growing?",
  "@descRitualCard47Prompt": {
    "description": "Ritual deck card 47: reflection prompt."
  },
  "descRitualCard47Quote": "One who performs actions without attachment, surrendering them to Brahman, is untouched by sin, like a lotus leaf by water.",
  "@descRitualCard47Quote": {
    "description": "Ritual deck card 47: quote."
  },
  "descRitualCard47Source": "Bhagavad Gita 5.10",
  "@descRitualCard47Source": {
    "description": "Ritual deck card 47: source of the quote."
  },
  "descRitualCard48Title": "Om Shanti",
  "@descRitualCard48Title": {
    "description": "Ritual deck card 48: title."
  },
  "descRitualCard48Prompt": "Sit still and repeat Om Shanti three times — peace in body, peace in mind, peace in spirit. What disturbance melts away as you do this?",
  "@descRitualCard48Prompt": {
    "description": "Ritual deck card 48: reflection prompt."
  },
  "descRitualCard48Quote": "Om Shantih Shantih Shantih — Om, Peace, Peace, Peace.",
  "@descRitualCard48Quote": {
    "description": "Ritual deck card 48: quote."
  },
  "descRitualCard48Source": "Upanishadic Shanti Mantra",
  "@descRitualCard48Source": {
    "description": "Ritual deck card 48: source of the quote."
  },
  "descRitualCard49Title": "May All Be Happy",
  "@descRitualCard49Title": {
    "description": "Ritual deck card 49: title."
  },
  "descRitualCard49Prompt": "Silently wish well-being for yourself, then for your loved ones, then for strangers, then for all beings. Notice how your heart expands as the circle widens.",
  "@descRitualCard49Prompt": {
    "description": "Ritual deck card 49: reflection prompt."
  },
  "descRitualCard49Quote": "Sarve bhavantu sukhinah, sarve santu niramayah. Sarve bhadrani pashyantu, ma kashchit duhkhabhag bhavet. — May all be happy, may all be free from disease, may all see auspiciousness, may none suffer.",
  "@descRitualCard49Quote": {
    "description": "Ritual deck card 49: quote."
  },
  "descRitualCard49Source": "Upanishadic Prayer",
  "@descRitualCard49Source": {
    "description": "Ritual deck card 49: source of the quote."
  },
  "descRitualCard50Title": "Strength and Peace Together",
  "@descRitualCard50Title": {
    "description": "Ritual deck card 50: title."
  },
  "descRitualCard50Prompt": "True strength does not come from tension; it comes from deep inner peace. Where in your life can you replace force with calm resolve today?",
  "@descRitualCard50Prompt": {
    "description": "Ritual deck card 50: reflection prompt."
  },
  "descRitualCard50Quote": "Strength is life, weakness is death. Strength is the medicine, strength is the cure. Strength, strength is what the Upanishads preach.",
  "@descRitualCard50Quote": {
    "description": "Ritual deck card 50: quote."
  },
  "descRitualCard50Source": "Swami Vivekananda",
  "@descRitualCard50Source": {
    "description": "Ritual deck card 50: source of the quote."
  },

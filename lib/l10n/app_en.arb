  "@descRitualCard02Prompt": {
    "description": "Ritual deck card 2: reflection prompt."
  },
  "descRitualCard02Quote": "Dharma exists for the welfare of all beings. Hence, that by which the welfare of all living beings is sustained, that is Dharma.",

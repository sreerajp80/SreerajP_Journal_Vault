<?xml version="1.0" encoding="utf-8"?>
<!--
  Sensitive Data Extension, engineering standard 15.2 and security.md section 10.

  This app stores an encrypted journal database, encrypted attachments, and
  Keystore-wrapped secrets. None of it may leave the device through Android's
  automatic backup or device-to-device transfer.

  android:allowBackup="false" in AndroidManifest.xml covers API 30 and below.
  This file covers API 31 and above, where allowBackup alone does NOT stop
  device-to-device transfer.

  Note on Keystore: the wrapping keys never leave the secure hardware, so a
  transferred copy of the wrapped secrets would be undecryptable anyway. These
  rules stop the ciphertext and the database from being copied at all.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
